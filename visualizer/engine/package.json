{
    "name": "faran-visualizer-engine",
    "version": "0.1.0",
    "private": true,
    "description": "Canvas engine that draws Faran visualizer animations in the browser",
    "type": "module",
    "packageManager": "pnpm@10.30.1",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "build": "pnpm run check && pnpm run test && vite build",
        "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && biome lint",
        "test": "vitest run"
    },
    "license": "MIT",
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@types/node": "^26.6.6",
        "@types/three": "0.180.0",
        "svelte-check": "^4.7.8",
        "typescript": "^5.9.3",
        "vite": "^7.2.2",
        "vitest": "^4.0.8"
    },
    "dependencies": {
        "svelte": "^5.59.1",
        "three": "0.180.0",
        "uplot": "1.6.32"
    }
}
