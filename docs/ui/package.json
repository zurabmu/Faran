{
    "name": "faran-docs-ui",
    "version": "0.1.0",
    "private": true,
    "description": "Svelte custom elements for the Faran documentation site",
    "type": "module",
    "packageManager": "pnpm@10.30.1",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "build": "pnpm run check && pnpm run logo && pnpm run katex && vite build",
        "logo": "tsx scripts/logo.ts",
        "katex": "tsx scripts/katex.ts",
        "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "dev": "vite build --watch"
    },
    "license": "MIT",
    "devDependencies": {
        "@rerun-io/web-viewer": "0.43.2",
        "@resvg/resvg-js": "^2.6.2",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@types/node": "^26.6.6",
        "@types/three": "0.180.0",
        "png-to-ico": "^3.0.2",
        "svelte": "^5.43.0",
        "svelte-check": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vite": "^7.2.2"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-python": "6.2.1",
        "@codemirror/language": "^6.13.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/common": "^1.5.6",
        "@lezer/highlight": "^1.2.5",
        "@lezer/python": "1.1.19",
        "@zag-js/hover-card": "^1.49.0",
        "@zag-js/number-input": "^1.49.0",
        "@zag-js/radio-group": "^1.49.0",
        "@zag-js/svelte": "^1.49.0",
        "@zag-js/tabs": "^1.49.0",
        "codemirror": "6.0.2",
        "comlink": "^4.4.2",
        "katex": "0.19.0",
        "three": "0.180.0"
    }
}
