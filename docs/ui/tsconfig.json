{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": ["svelte", "node", "vite/client"],
        "paths": { "@/*": ["./src/*"], "@engine": ["../../visualizer/engine/src/index.ts"], "@engine/*": ["../../visualizer/engine/src/*"] }
    },
    "include": ["src/**/*.ts", "src/**/*.svelte", "scripts/**/*.ts", "vite.config.ts"]
}
